{
    "scene_id": "scene_10",
    "scene_description": {
        "int_ext": "EXT",
        "location": "MALL TABLES",
        "time_of_day": "DAY",
        "actors_involved": [
            "KAY",
            "MICHAEL"
        ]
    },
    "clips": [
        {
            "clip_id": "scene_10_clip_1",
            "clip_description": [
                "KAY and MICHAEL settle at a table on the edge of the wedding, carrying plates of food and glasses of wine.",
                "KAY is exhilarated by the scale of the celebration, the music, and the vitality around her."
            ],
            "actors_involved": [
                "KAY",
                "MICHAEL"
            ],
            "dialogue": [
                {
                    "timestamp_start_sec": 0.0,
                    "timestamp_end_sec": 4.0,
                    "actor": "KAY",
                    "text": "I've never seen anything like it."
                },
                {
                    "timestamp_start_sec": 4.5,
                    "timestamp_end_sec": 8.5,
                    "actor": "MICHAEL",
                    "text": "I told you I had a lot of relatives."
                }
            ]
        },
        {
            "clip_id": "scene_10_clip_2",
            "clip_description": [
                "KAY looks around the wedding curiously.",
                "Her attention is drawn to three men standing quietly by the wine barrels."
            ],
            "actors_involved": [
                "KAY",
                "MICHAEL"
            ],
            "dialogue": [
                {
                    "timestamp_start_sec": 9.0,
                    "timestamp_end_sec": 13.0,
                    "actor": "KAY",
                    "text": "Michael, what are those men doing?"
                },
                {
                    "timestamp_start_sec": 13.5,
                    "timestamp_end_sec": 17.5,
                    "actor": "MICHAEL",
                    "text": "They're waiting to see my father."
                },
                {
                    "timestamp_start_sec": 18.0,
                    "timestamp_end_sec": 22.0,
                    "actor": "KAY",
                    "text": "They're talking to themselves."
                },
                {
                    "timestamp_start_sec": 22.5,
                    "timestamp_end_sec": 26.5,
                    "actor": "MICHAEL",
                    "text": "They're going to talk to my father, which means they're going to ask him for something, which means they better get it right."
                },
                {
                    "timestamp_start_sec": 27.0,
                    "timestamp_end_sec": 31.0,
                    "actor": "KAY",
                    "text": "Why do they bother him on a day like this?"
                },
                {
                    "timestamp_start_sec": 31.5,
                    "timestamp_end_sec": 35.5,
                    "actor": "MICHAEL",
                    "text": "Because they know that no Sicilian will refuse a request on his daughter's wedding day."
                }
            ]
        }
    ]
}